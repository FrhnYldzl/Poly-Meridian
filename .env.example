# ===== Poly Meridian env (copy to .env, never commit) =====

# --- Operation mode ---
# paper | live-conservative | live-normal | kill
MODE=paper

# --- Polymarket (CLOB) ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- On-chain (Polygon) ---
ALCHEMY_API_KEY=
POLYGON_RPC_URL=

# --- News / sentiment sources ---
GDELT_API_KEY=
NEWSAPI_KEY=
X_BEARER_TOKEN=

# --- LLM providers ---
# Each accepts a `_POLLY_AGENT` suffix variant if you share a Railway account
# across projects (e.g. ANTHROPIC_API_KEY_POLLY_AGENT also works).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini free tier — 15 RPM, 1M tokens/day on gemini-2.5-flash.
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Storage ---
POSTGRES_URL=postgresql+asyncpg://poly:polypass@db:5432/poly_meridian
POSTGRES_PASSWORD=polypass
REDIS_URL=redis://redis:6379/0

# --- Alerts ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability ---
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO
