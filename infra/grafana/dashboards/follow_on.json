{
  "title": "Poly Meridian — Follow-On (Smart Money)",
  "uid": "poly-meridian-follow-on",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tracked wallets",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "pm_smart_wallets_total", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 2,
      "title": "Tier 1 wallets",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "pm_smart_wallets_by_tier{tier=\"1\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short", "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "title": "Tier 2 wallets",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "pm_smart_wallets_by_tier{tier=\"2\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "unit": "short", "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "title": "Tier 3 wallets (observation)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "pm_smart_wallets_by_tier{tier=\"3\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short", "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "title": "Active clusters",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "pm_active_clusters", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 6,
      "title": "Leaderboard refresh",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "time() - pm_leaderboard_refresh_seconds", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 7,
      "title": "Smart-money signals (per tier)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(pm_smart_money_signal_total[10m])",
          "legendFormat": "tier {{tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Smart-money cluster size distribution",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pm_smart_money_cluster_size_bucket[10m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(pm_smart_money_cluster_size_bucket[10m])))",
          "legendFormat": "p90",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Copy-trades submitted",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(pm_smart_money_copy_total[10m])",
          "legendFormat": "tier {{tier}} {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Tier 3 surfacing (auto-trade OFF — informational)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(pm_smart_money_tier3_surface_total[10m])",
          "legendFormat": "tier3 surface",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Filter rejections (why we didn't copy)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "rate(pm_smart_money_filtered_total[10m])",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    }
  ]
}
