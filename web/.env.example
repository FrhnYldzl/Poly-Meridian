# Poly Meridian web — local dev only.
#
# In production (Railway), the agent's FastAPI process serves the static
# Next.js build at /, so the dashboard fetches /api/* same-origin without
# any env var.
#
# Locally, the dashboard runs on :3001 and the agent on :8000 — point
# NEXT_PUBLIC_API_URL at the agent so SSE + REST work cross-origin.

NEXT_PUBLIC_API_URL=http://localhost:8000
